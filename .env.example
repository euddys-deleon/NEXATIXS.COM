# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Calendly (Fase 3 — flujo de captación) — no referenciado en el código
# actual (src/app/[locale]/(marketing)/agendar-cita usa book_appointment(),
# no Calendly); dejar hasta confirmar si sigue en el roadmap.
CALENDLY_API_KEY=
NEXT_PUBLIC_CALENDLY_URL=

# Gemini API (chatbot del Portal de Cliente — src/app/api/chat,
# src/app/api/chat-public). El código lee GEMINI_API_KEY, no ANTHROPIC_API_KEY.
GEMINI_API_KEY=

# Sitio
NEXT_PUBLIC_SITE_URL=https://nexatixs.com
NEXT_PUBLIC_CONTACT_EMAIL=soporte@nexatixs.com
